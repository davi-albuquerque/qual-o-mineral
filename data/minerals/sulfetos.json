      "heading": "",
      "body": "Argentina                    Ag2S                                       Cinábrio                  HgS"
    },
    {
      "key": "preamble",
      "heading": "",
      "body": "Calcocita                    Cu2S                                       Realgar                   AsS"
    },
    {
